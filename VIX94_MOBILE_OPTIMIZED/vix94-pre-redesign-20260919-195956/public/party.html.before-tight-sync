<script>
"use strict";

(function(){
    const MUSIC_BASE="https://pub-feb120eabdf4471980ef8f1331d8baab.r2.dev/afterhoursmusicmix/";
    const LIBRARY_URL=MUSIC_BASE+"library.json";
    const WS_BASE="wss://party.vix94.buzz/listen/";

    const $=id=>document.getElementById(id);
    const audio=$("partyAudio");

    let files=[];
    let queue=[];
    let queuePos=-1;
    let socket=null;
    let room="";
    let username="";
    let creator=false;
    let connected=false;
    let serverOffset=0;
    let syncTimer=null;
    let correctionTimer=null;
    let lastState=null;
    let title="VIX 94' RADIO";
    let artist="WAITING FOR THE PARTY";
    let artwork="/vix94logobg.png";
    let seenChat=new Set();

/* Track metadata cache.
   The metadata reader below expects these to exist before the first
   CREATE/JOIN action. */
const tagCache=new Map();
const META_TIMEOUT=5000;
    let connectionTimer=null;
    let roomStateReceived=false;
    let socketGeneration=0;
    let participantReconnectAttempts=0;
    let intentionalDisconnect=false;

    /* Participant sync tuning. Deliberately conservative to avoid audible
       stutter on mobile while still correcting meaningful clock drift. */
    const HARD_SYNC_SECONDS=0.45;
    const SOFT_SYNC_SECONDS=0.07;
    let lastHardSync=0;
    let rateCorrectionUntil=0;
    let pendingSyncTarget=null;
    let lastSyncStateAt=0;
    let participantPlayAttemptAt=0;

    function setConnection(text,on){
        $("partyConnectionText").textContent=text;
        $("partyConnectionDot").classList.toggle("connected",!!on);
    }

    function setError(text){
        $("partyError").textContent=text||"";
    }

    function setConnectedUI(on){
        $("partyChatInput").disabled=!on;
        $("partySend").disabled=!on;
    }

    function updateCount(n){
        const count=Math.max(1,Number(n)||1);
        $("partyListeners").textContent=count;
        $("partyChatLive").textContent=count+" LIVE";
    }

    function serverNow(){
        return Date.now()+serverOffset;
    }

    function send(type,data){
        if(!socket||socket.readyState!==WebSocket.OPEN)return false;
        try{
            socket.send(JSON.stringify(Object.assign({type,room},data||{})));
            return true;
        }catch(_){return false}
    }

    function fileUrl(file){
        return MUSIC_BASE+file.split("/").map(encodeURIComponent).join("/");
    }

    function buildQueue(){
        queue=files.map((_,i)=>i);
        for(let i=queue.length-1;i>0;i--){
            const j=Math.floor(Math.random()*(i+1));
            [queue[i],queue[j]]=[queue[j],queue[i]];
        }
        queuePos=0;
    }

    function nextFile(){
        if(!files.length)return null;
        if(!queue.length||queuePos>=queue.length-1)buildQueue();
        else queuePos++;
        return files[queue[queuePos]];
    }

    function prevFile(){
        if(!files.length)return null;
        if(!queue.length)buildQueue();
        if(queuePos>0)queuePos--;
        return files[queue[queuePos]];
    }

    async function loadLibrary(){
        const r=await fetch(LIBRARY_URL,{cache:"no-store"});
        if(!r.ok)throw new Error("Music library unavailable.");
        const data=await r.json();
        if(!Array.isArray(data))throw new Error("Invalid music library.");
        files=data.filter(x=>typeof x==="string"&&x.trim());
        if(!files.length)throw new Error("No music files found.");
        buildQueue();
    }

    function updateTrackUI(){
        $("partyTrackTitle").textContent=title||"VIX 94' RADIO";
        $("partyTrackArtist").textContent=artist||"VIX 94'";
        $("partyArtwork").src=artwork||"/vix94logobg.png";
    }

    async function readTags(src){
        if(!src)return null;
        if(tagCache.has(src))return tagCache.get(src);

        const promise=new Promise(resolve=>{
            if(typeof jsmediatags==="undefined"){
                resolve(null);
                return;
            }

            let finished=false;

            const finish=value=>{
                if(finished)return;
                finished=true;
                resolve(value||null);
            };

            const timer=setTimeout(()=>{
                finish(null);
            },META_TIMEOUT);

            try{
                /*
                 * Use the same jsmediatags URL-reading method as the
                 * working VIX 94' main player.
                 */
                jsmediatags.read(src,{

                    onSuccess(result){
                        clearTimeout(timer);

                        const tags=result.tags||{};

                        const meta={
                            title:String(tags.title||"").trim(),
                            artist:String(tags.artist||"").trim(),
                            album:String(tags.album||"").trim(),
                            artwork:""
                        };

                        /*
                         * Use embedded artwork exactly like the main player.
                         */
                        if(tags.picture){

                            const picture=tags.picture;

                            let binary="";

                            for(
                                let i=0;
                                i<picture.data.length;
                                i++
                            ){
                                binary+=String.fromCharCode(
                                    picture.data[i]
                                );
                            }

                            try{
                                meta.artwork=
                                    "data:"+
                                    picture.format+
                                    ";base64,"+
                                    window.btoa(binary);
                            }catch(_){}
                        }

                        finish(meta);
                    },

                    onError(){
                        clearTimeout(timer);
                        finish(null);
                    }

                });

            }catch(_){
                clearTimeout(timer);
                finish(null);
            }
        });

        tagCache.set(src,promise);
        return promise;
    }

    function cleanFileTitle(file){
        return String(file||"")
            .split("/")
            .pop()
            .replace(/\.[^/.]+$/,"")
            .replace(/[._-]+/g," ")
            .replace(/\s+/g," ")
            .trim();
    }

    async function getTrackMetadata(src,file){
        const meta=await readTags(src);

        /*
         * Never replace valid room metadata with the filename.
         */
        if(meta){

            if(meta.title){
                title=meta.title;
            }

            if(meta.artist){
                artist=meta.artist;
            }

            if(meta.artwork){
                artwork=meta.artwork;
            }
        }

        /*
         * Only use the cleaned filename if the MP3 contains no
         * readable title metadata.
         */
        if(
            !title ||
            title==="LOADING…" ||
            title==="VIX 94' RADIO"
        ){
            title=cleanFileTitle(file);
        }

        if(!artist){
            artist="VIX 94'";
        }

        updateTrackUI();

        return {
            title,
            artist,
            artwork
        };
    }

    async function loadTrack(file,shouldPlay,position){
        if(!file)return;
        title="LOADING…";
        artist="";
        artwork="/vix94logobg.png";
        updateTrackUI();

        audio.pause();
        audio.src=fileUrl(file);
        audio.load();

        /*
         * IMPORTANT:
         * For the creator, call play() immediately while the CREATE/NEXT/PREV
         * click is still an active browser user gesture. The previous version
         * waited for loadedmetadata first; that loses the user-activation
         * window in Safari/Chrome and caused the "READY TO LISTEN" modal to
         * remain open after creating a room.
         */
        let creatorPlayPromise=null;
        if(shouldPlay && creator){
            try{
                creatorPlayPromise=audio.play();
                if(creatorPlayPromise && creatorPlayPromise.catch){
                    creatorPlayPromise.catch(()=>{
                        $("partyRole").textContent="CREATOR · READY — PRESS PLAY TO START";
                        closeAudioPrompt();
                    });
                }
            }catch(_){
                $("partyRole").textContent="CREATOR · READY — PRESS PLAY TO START";
                closeAudioPrompt();
            }
        }

        await new Promise(resolve=>{
            let done=false;
            const finish=()=>{
                if(done)return;
                done=true;
                audio.removeEventListener("loadedmetadata",finish);
                resolve();
            };
            audio.addEventListener("loadedmetadata",finish);
            setTimeout(finish,1800);
        });

        try{
            await getTrackMetadata(audio.src,file);
        }catch(_){
            /* Metadata is optional; playback/room creation must continue. */
            title=cleanFileTitle(file);
            artist=artist||"VIX 94'";
            updateTrackUI();
        }

        if(Number.isFinite(position)){
            try{
                if(Number.isFinite(audio.duration)&&audio.duration>0){
                    audio.currentTime=Math.max(0,Math.min(audio.duration-.05,position));
                }
            }catch(_){}
        }

        if(shouldPlay && !creator){
            const p=audio.play();
            if(p&&p.catch){
                p.catch(()=>openAudioPrompt());
            }
        }else if(shouldPlay && creator){
            /*
             * The initial play() was intentionally made before the async wait.
             * Do not show an autoplay modal for the creator. If the browser
             * still rejected it, the visible PLAY control is the fallback.
             */
            closeAudioPrompt();
        }
    }

    function normalizedMediaUrl(src){
        if(!src)return "";
        try{
            return new URL(src,location.href).href;
        }catch(_){
            return String(src);
        }
    }

    function sameMediaSource(a,b){
        return normalizedMediaUrl(a) === normalizedMediaUrl(b);
    }

    function projectedPosition(state){
        if(!state)return NaN;

        const base=Number(state.position);

        if(!Number.isFinite(base))return NaN;

        /*
         * The Worker stamps the state with serverAt when it broadcasts it.
         * serverOffset estimates the difference between the Cloudflare
         * server clock and this device's clock.
         */
        const serverStamp=Number(
            state.serverAt ?? state.sentAt
        );

        if(
            state.playing &&
            Number.isFinite(serverStamp)
        ){
            const elapsed=
                (Date.now()+serverOffset-serverStamp)/1000;

            return Math.max(
                0,
                base+Math.max(0,elapsed)
            );
        }

        return Math.max(0,base);
    }

    function setParticipantPosition(position){
        if(!Number.isFinite(position))return;
        if(!Number.isFinite(audio.duration) || audio.duration<=0)return;

        const safe=Math.max(
            0,
            Math.min(audio.duration-0.05,position)
        );

        try{
            audio.currentTime=safe;
        }catch(_){}
    }

    async function applyRemoteState(state){
        if(!state)return;

        lastState=Object.assign({},state);
        lastSyncStateAt=performance.now();

        /*
         * Room state already contains the host's metadata when available.
         * Display it immediately. Metadata extraction from R2 happens
         * separately and must never block synchronized playback.
         */
        if(state.title && state.title!=="LOADING…"){
            title=state.title;
        }

        if(state.artist){
            artist=state.artist;
        }

        updateTrackUI();

        const targetSrc=state.src||"";
        const currentSrc=audio.src||audio.currentSrc||"";
        const needsTrack=!!targetSrc && !sameMediaSource(currentSrc,targetSrc);

        if(needsTrack){

            /*
             * Stop the old track exactly once.
             * Do not call loadTrack(), because that function contains
             * creator-specific autoplay/metadata behavior.
             */
            try{
                audio.pause();
                audio.playbackRate=1;
            }catch(_){}

            audio.preload="auto";
            audio.src=targetSrc;
            audio.load();

            /*
             * Metadata is completely independent from synchronization.
             * It is allowed to finish whenever it finishes.
             */
            const file=decodeURIComponent(
                targetSrc.split("/").pop()||""
            );

            getTrackMetadata(targetSrc,file).catch(()=>{
                if(!title || title==="LOADING…"){
                    title=cleanFileTitle(file);
                }
                if(!artist){
                    artist="VIX 94'";
                }
                updateTrackUI();
            });

            /*
             * Synchronization does not wait for ID3 metadata.
             * It only waits until the browser knows the media duration.
             */
            await new Promise(resolve=>{
                if(
                    Number.isFinite(audio.duration) &&
                    audio.duration>0
                ){
                    resolve();
                    return;
                }

                let finished=false;

                const finish=()=>{
                    if(finished)return;
                    finished=true;
                    audio.removeEventListener(
                        "loadedmetadata",
                        finish
                    );
                    audio.removeEventListener(
                        "durationchange",
                        finish
                    );
                    resolve();
                };

                audio.addEventListener(
                    "loadedmetadata",
                    finish,
                    {once:true}
                );

                audio.addEventListener(
                    "durationchange",
                    finish,
                    {once:true}
                );

                setTimeout(finish,2500);
            });

            /*
             * Place the participant at the host's projected position once.
             */
            const target=projectedPosition(state);

            if(
                Number.isFinite(target) &&
                Number.isFinite(audio.duration) &&
                audio.duration>0
            ){
                setParticipantPosition(target);
                lastHardSync=performance.now();
            }
        }

        /*
         * If this is the same track, NEVER reload it.
         * Only calculate the current clock difference.
         */
        const target=projectedPosition(state);

        if(
            Number.isFinite(target) &&
            Number.isFinite(audio.duration) &&
            audio.duration>0
        ){

            const delta=target-audio.currentTime;

            /*
             * A new track or a very large drift gets one controlled seek.
             * This is deliberately much less aggressive than the previous
             * implementation.
             */
            if(
                !needsTrack &&
                Math.abs(delta)>=1.25 &&
                performance.now()-lastHardSync>4000 &&
                !audio.seeking &&
                audio.readyState>=2
            ){
                setParticipantPosition(target);
                audio.playbackRate=1;
                lastHardSync=performance.now();
                rateCorrectionUntil=0;
            }
        }

        /*
         * Host playback state is authoritative.
         */
        if(state.playing){

            /*
             * Only try to start/resume when the browser has actually paused.
             * Do not repeatedly call play() while already playing.
             */
            if(
                audio.paused &&
                !audio.seeking &&
                audio.readyState>=2
            ){
                tryResumeParticipant();
            }

        }else{

            /*
             * A host pause is an explicit pause. Reset all correction state.
             */
            if(!audio.paused){
                try{
                    audio.pause();
                }catch(_){}
            }

            audio.playbackRate=1;
            rateCorrectionUntil=0;
        }
    }

    function tryResumeParticipant(){
        if(
            creator ||
            !lastState ||
            !lastState.playing ||
            !connected
        )return;

        if(!audio.paused)return;

        const now=performance.now();

        /*
         * Prevent repeated play() calls during mobile buffering.
         */
        if(now-participantPlayAttemptAt<1500)return;

        participantPlayAttemptAt=now;

        const promise=audio.play();

        if(promise&&promise.catch){
            promise.catch(()=>{
                /*
                 * Mobile browsers may require one user gesture before
                 * allowing remote audio. Only show the prompt when play()
                 * is genuinely rejected.
                 */
                if(!creator){
                    openAudioPrompt();
                }
            });
        }
    }

    function syncParticipant(){
        if(
            creator ||
            !lastState ||
            !lastState.playing ||
            !connected
        )return;

        if(
            !Number.isFinite(audio.duration) ||
            audio.duration<=0
        )return;

        if(audio.seeking)return;

        if(audio.paused){
            tryResumeParticipant();
            return;
        }

        const target=projectedPosition(lastState);

        if(!Number.isFinite(target))return;

        const delta=target-audio.currentTime;
        const absDelta=Math.abs(delta);
        const now=performance.now();

        /*
         * Essentially synchronized.
         */
        if(absDelta<0.08){
            audio.playbackRate=1;
            rateCorrectionUntil=0;
            return;
        }

        /*
         * Proportional correction.
         * A larger drift receives a stronger but still subtle
         * playback-rate adjustment.
         */
        if(absDelta<1.0){
            const correction=Math.min(
                0.03,
                Math.max(
                    0.004,
                    absDelta*0.04
                )
            );

            audio.playbackRate=
                delta>0
                    ? 1+correction
                    : 1-correction;

            rateCorrectionUntil=now+600;
            return;
        }

        /*
         * Large drift: one controlled seek.
         */
        if(
            absDelta>=1.0 &&
            now-lastHardSync>=3000 &&
            audio.readyState>=3
        ){
            try{
                const safeTarget=Math.max(
                    0,
                    Math.min(audio.duration-.05,target)
                );

                audio.currentTime=safeTarget;
                audio.playbackRate=1;
                lastHardSync=now;
                rateCorrectionUntil=0;
            }catch(_){}
        }
    }

