    function connect(code,isCreator,name){
        room=String(code||"").trim().toUpperCase();
        creator=!!isCreator;
        username=String(name||"").trim();

        const myGeneration=++socketGeneration;
        intentionalDisconnect=false;
        roomStateReceived=false;

        if(socket){
            try{ socket.close(1000,"reconnect"); }catch(_){}
            socket=null;
        }

        clearTimeout(connectionTimer);
        clearInterval(syncTimer);

        setError("");
        setConnection("CONNECTING",false);
        setConnectedUI(false);

        if(!room || !/^[A-Z0-9]{6}$/.test(room)){
            setError("Invalid Party Code.");
            setConnection("ERROR",false);
            return;
        }

        let ws;
        try{
            ws=new WebSocket(WS_BASE+encodeURIComponent(room));
            socket=ws;
        }catch(error){
            if(myGeneration!==socketGeneration)return;
            setConnection("CONNECTION ERROR",false);
            setError("Unable to connect to Party Mode.");
            return;
        }

        /*
         * A WebSocket can emit error before close, and browsers sometimes
         * expose a transient error even though the connection subsequently
         * opens. Do not treat `error` alone as a failed join.
         */
        ws.onopen=function(){
            if(myGeneration!==socketGeneration)return;

            connected=true;
            participantReconnectAttempts=0;
            roomStateReceived=false;

            setConnection("CONNECTED",true);
            setConnectedUI(true);
            showLive();
            setError("");

            if(creator) closeAudioPrompt();

            const ok=send("join",{
                creator:creator,
                username:username,
                state:creator?currentState():null
            });

            if(!ok){
                setError("Connected, but could not send the room request.");
                return;
            }

            /*
             * The WebSocket itself is the connection confirmation. The
             * room-state message is used for synchronization/role data,
             * not as a prerequisite for showing the room UI.
             */
            $("partyRole").textContent=creator
                ?"CREATOR · CONNECTED"
                :"PARTICIPANT · CONNECTED";

            clearInterval(syncTimer);
            syncTimer=setInterval(function(){
                if(myGeneration!==socketGeneration)return;

                if(creator){
                    if(connected) send("clock",{state:currentState()});
                }else{
                    syncParticipant();
                }
            },1000);

            /*
             * If a room-state response is not received, report a useful
             * diagnostic instead of pretending the WebSocket failed.
             */
            clearTimeout(connectionTimer);
            connectionTimer=setTimeout(function(){
                if(myGeneration!==socketGeneration)return;
                if(connected && !roomStateReceived){
                    $("partySync").textContent=creator
                        ?"HOST · WAITING FOR ROOM"
                        :"CONNECTED · WAITING FOR HOST";
                    setError("");
                }
            },5000);
        };

        ws.onmessage=async function(event){
            if(myGeneration!==socketGeneration)return;

            let msg;
            try{
                msg=JSON.parse(event.data);
            }catch(_){
                return;
            }

            if(typeof msg.serverNow==="number"){
                serverOffset=msg.serverNow-Date.now();
            }

            if(msg.type==="room-state"){
                roomStateReceived=true;
                clearTimeout(connectionTimer);

                updateCount(msg.count);

                /*
                 * Role comes from the Durable Object. Never let a participant
                 * claim creator status simply because the local button said
                 * "join".
                 */
                const serverIsCreator=(
                    msg.hostId &&
                    msg.clientId &&
                    msg.hostId===msg.clientId
                );

                if(serverIsCreator){
                    creator=true;
                    document.body.classList.add("party-is-host");
                    document.body.classList.remove("party-is-participant");
                    $("partyRole").textContent="CREATOR · YOU CONTROL THE MUSIC";
                    $("partyHostControls").style.display="grid";
                    $("partyRoomTools").style.display="";
                    $("partyProgress").style.display="";
                    $("partyTimes").style.display="";
                }else{
                    creator=false;
                    document.body.classList.add("party-is-participant");
                    document.body.classList.remove("party-is-host");
                    $("partyRole").textContent="PARTICIPANT · LISTENING ONLY";
                    $("partyHostControls").style.display="none";
                    $("partyRoomTools").style.display="none";
                    $("partyProgress").style.display="none";
                    $("partyTimes").style.display="none";
                }

                $("partyRoomCode").textContent=room;

                if(msg.state && !creator){
                    $("partySync").textContent="SYNCING…";
                    try{
                        await applyRemoteState(msg.state);
                        if(msg.state.playing){
                            $("partySync").textContent="SYNCED";
                        }else{
                            $("partySync").textContent="PAUSED";
                        }
                    }catch(_){
                        $("partySync").textContent="CONNECTED · WAITING FOR AUDIO";
                    }
                }else if(!msg.state && !creator){
                    $("partySync").textContent="CONNECTED · WAITING FOR HOST";
                }

                return;
            }

            if(msg.type==="presence"){
                updateCount(msg.count);
                return;
            }

            if(msg.type==="clock"){
                if(msg.state){
                    lastState=Object.assign({},msg.state);
                    if(!creator){
                        syncParticipant();
                    }
                }
                return;
            }

            if(msg.type==="command"){
                lastState=msg.state||lastState;
                if(!creator){
                    try{ await applyRemoteState(msg.state); }catch(_){}
                }
                return;
            }

            if(msg.type==="chat"){
                renderMessage(msg.username,msg.text,msg.chatId);
            }
        };

        ws.onerror=function(){
            if(myGeneration!==socketGeneration)return;

            /*
             * Do not show a fatal "connection failed" message here.
             * Browsers can emit error immediately before close.
             */
            setConnection("RECONNECTING",false);
        };

        ws.onclose=function(event){
            if(myGeneration!==socketGeneration)return;

            connected=false;
            setConnectedUI(false);
            clearInterval(syncTimer);
            clearTimeout(connectionTimer);

            if(intentionalDisconnect)return;

            if(!creator && participantReconnectAttempts<3){
                participantReconnectAttempts++;

                const delay=500*participantReconnectAttempts;

                setConnection("RECONNECTING",false);
                setError("Reconnecting to Party Mode…");

                setTimeout(function(){
                    if(myGeneration!==socketGeneration)return;
                    connect(room,false,username);
                },delay);

                return;
            }

            setConnection("DISCONNECTED",false);

            /*
             * Give a meaningful error only after the socket actually closed
             * and the participant retry window has been exhausted.
             */
            if(!roomStateReceived){
                setError(
                    "Unable to connect to this party. Check the 6-character code and try again."
                );
            }else{
                setError("Party Mode disconnected. Please reconnect.");
            }
        };
    }

