        if(!connected||!socket||socket.readyState!==WebSocket.OPEN){
            setError("Chat is not connected yet.");
            return;
        }

        const chatId=(crypto.randomUUID?crypto.randomUUID():String(Date.now())+"-"+Math.random());

        /*
         * Render immediately for the sender. The Worker echoes the same
         * chatId back to every client, and renderMessage() de-duplicates it.
         * This removes the apparent "chat does nothing" delay.
         */
        renderMessage(username||"Guest",text.slice(0,180),chatId);

        if(!send("chat",{chatId:chatId,text:text.slice(0,180)})){
            setError("Message could not be sent.");
            return;
        }

        $("partyChatInput").value="";
        $("partyChatInput").focus();
    });

    $("partyChatInput").addEventListener("keydown",function(event){
        if(event.key==="Enter"&&!event.shiftKey){
            event.preventDefault();
            $("partySend").click();
        }
    });

    $("partyCopyCode").addEventListener("click",async function(){
        if(!room)return;
        try{
            await navigator.clipboard.writeText(room);
            this.textContent="COPIED";
            setTimeout(()=>this.textContent="COPY CODE",1000);
        }catch(_){}
    });

    $("partyShare").addEventListener("click",async function(){
        if(!room)return;

        const url=new URL("https://vix94.buzz/");
        url.searchParams.set("party",room);
        url.hash="party";

        try{
            if(navigator.share){
                await navigator.share({
                    title:"VIX 94' — Party Mode",
                    text:"Join my VIX 94' Party Mode room.",
                    url:url.toString()
                });
            }else{
                await navigator.clipboard.writeText(url.toString());
                this.textContent="LINK COPIED";
                setTimeout(()=>this.textContent="SHARE PARTY",1200);
            }
        }catch(_){}
    });

    $("partyExit").addEventListener("click",function(){
        intentionalDisconnect=true;
        socketGeneration++;
        clearTimeout(connectionTimer);
        clearInterval(syncTimer);
        try{if(socket)socket.close(1000,"exit")}catch(_){}
        try{audio.pause()}catch(_){}
        location.href="/";
    });

    $("partyAudioStart").addEventListener("click",function(){
        closeAudioPrompt();
        const p=audio.play();
        if(p&&p.catch)p.catch(()=>openAudioPrompt());
    });

    $("partyCodeInput").addEventListener("input",function(){
        this.value=this.value.toUpperCase().replace(/[^A-Z0-9]/g,"").slice(0,6);
        setError("");
    });

    $("partyUsername").addEventListener("input",function(){
        setError("");
        const value=this.value.trim();
        if(value){
            try{localStorage.setItem("vix94PartyUsername",value)}catch(_){}
        }
    });

    /* Restore the last username for a smoother shared-link join. */
    try{
        const savedName=localStorage.getItem("vix94PartyUsername");
        if(savedName && !$("partyUsername").value){
            $("partyUsername").value=savedName;
        }
    }catch(_){}

    /*
     * Shared links use https://vix94.buzz/?party=AB12CD#party.
     * index.html redirects that URL to /party.html?party=AB12CD#party.
     * If a username is already known, join automatically; otherwise the
     * room code is ready and the user only needs to enter a name.
     */
    const qs=new URLSearchParams(location.search);
    const sharedCode=qs.get("party");
    const validSharedCode=sharedCode&&/^[A-Z0-9]{6}$/.test(sharedCode.toUpperCase());

    if(validSharedCode){
        $("partyCodeInput").value=sharedCode.toUpperCase();
        $("partyJoinForm").classList.add("open");

        const savedName=$("partyUsername").value.trim();
        if(savedName){
            setTimeout(function(){
                $("partyJoin").click();
            },120);
        }else{
            $("partyUsername").focus();
        }
    }

    /* Native VIX menu. */
    const menu=$("vix94SiteMenu");
    const menuButton=$("vix94MenuButton");
    const menuClose=$("vix94SiteMenuClose");

    function closeMenu(){
        menu.classList.remove("open");
        menu.setAttribute("aria-hidden","true");
        menuButton.setAttribute("aria-expanded","false");
        document.body.style.overflow="";
    }

    function openMenu(){
        menu.classList.add("open");
        menu.setAttribute("aria-hidden","false");
        menuButton.setAttribute("aria-expanded","true");
        document.body.style.overflow="hidden";
    }

    menuButton.addEventListener("click",function(){
        menu.classList.contains("open")?closeMenu():openMenu();
    });

    menuClose.addEventListener("click",closeMenu);

    menu.addEventListener("click",function(event){
        if(event.target===menu)closeMenu();
    });

    document.addEventListener("keydown",function(event){
        if(event.key==="Escape"&&menu.classList.contains("open"))closeMenu();
    });

    /* Allow a participant to start audio from any direct tap after joining. */
    document.addEventListener("pointerdown",function(){
        if(!creator&&connected&&!audio.paused){
            closeAudioPrompt();
        }
    },{passive:true});

    loadLibrary().catch(function(error){
        console.warn("VIX 94' Party library:",error);
    });
})();
</script>
</body>
</html>
