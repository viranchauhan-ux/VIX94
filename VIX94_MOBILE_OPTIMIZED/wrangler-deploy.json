{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vix94",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Presence"
      ]
    }
  ]
}